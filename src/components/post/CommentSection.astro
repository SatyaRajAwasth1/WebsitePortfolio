---
interface Props {
    postSlug: string;
}

const { postSlug } = Astro.props;
---

<section
    id="comments-section"
    data-post-slug={postSlug}
    class="mt-12 pt-8 border-t border-gray-100 bg-gray-50/80 text-gray-900"
>
    <div class="flex items-center justify-between mb-8">
        <h2
            class="text-2xl md:text-3xl font-bold tracking-tight font-outfit text-gray-900"
        >
            Comments
        </h2>
        <div
            id="comment-count-header"
            class="text-xs font-bold text-indigo-400 uppercase tracking-widest bg-indigo-50 px-3 py-1 rounded-full"
        >
            0 Comments
        </div>
    </div>

    <!-- Login Prompt -->
    <div
        id="auth-prompt"
        class="hidden mb-10 p-6 bg-gray-50/80 border border-gray-100 rounded-3xl text-center"
    >
        <h3 class="text-lg font-bold mb-2 text-gray-900">
            Join the conversation
        </h3>
        <p class="text-gray-600 mb-4 text-sm max-w-xs mx-auto">
            Please sign in to share your thoughts about this article.
        </p>
        <button
            id="login-button"
            class="inline-flex items-center gap-2.5 px-6 md:px-8 py-3 bg-white hover:bg-gray-50 text-gray-900 text-xs md:text-base font-bold rounded-2xl border border-gray-200 transition-all duration-300 shadow-sm hover:shadow-md active:scale-95"
        >
            <svg
                class="w-5 h-5 flex-shrink-0"
                viewBox="0 0 24 24"
                xmlns="http://www.w3.org/2000/svg"
            >
                <path
                    d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
                    fill="#4285F4"></path>
                <path
                    d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-1 .67-2.28 1.07-3.71 1.07-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
                    fill="#34A853"></path>
                <path
                    d="M5.84 14.11c-.22-.66-.35-1.36-.35-2.11s.13-1.45.35-2.11V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l3.66-2.83z"
                    fill="#FBBC05"></path>
                <path
                    d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
                    fill="#EA4335"></path>
            </svg>
            Sign in with Google
        </button>
    </div>

    <!-- Comment Form -->
    <div id="comment-form-container" class="hidden mb-12">
        <div class="flex gap-4 sm:gap-6">
            <div class="flex-1">
                <div class="relative group">
                    <textarea
                        id="comment-input"
                        placeholder="Type your message..."
                        class="w-full p-5 bg-white border border-gray-200 rounded-2xl focus:ring-4 focus:ring-indigo-500/10 focus:border-indigo-500 transition-all outline-none text-gray-800 placeholder-gray-400 resize-none min-h-[140px] shadow-sm text-base leading-relaxed"
                        maxlength="1000"></textarea>
                </div>
                <div
                    class="flex flex-row justify-between items-center mt-4 gap-3"
                >
                    <span
                        id="comment-limit-text"
                        class="text-[10px] font-bold text-indigo-400 uppercase tracking-widest bg-indigo-50 px-3 py-1.5 rounded-full whitespace-nowrap"
                        >2 comments left</span
                    >
                    <button
                        id="post-comment-btn"
                        class="px-4 md:px-6 py-2 md:py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-xs md:text-sm font-bold rounded-2xl disabled:opacity-50 disabled:cursor-not-allowed transition-all shadow-lg shadow-indigo-200 active:scale-95 whitespace-nowrap"
                        disabled
                    >
                        Post Comment
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Comments List -->
    <div id="comments-list" class="space-y-8">
        <!-- Skeleton Loading -->
        <div class="animate-pulse space-y-8">
            {
                [1, 2].map(() => (
                    <div class="flex gap-6">
                        <div class="w-12 h-12 bg-gray-100 rounded-2xl" />
                        <div class="flex-1 space-y-2">
                            <div class="h-4 bg-gray-100 rounded w-1/4" />
                            <div class="h-4 bg-gray-100 rounded w-full" />
                            <div class="h-4 bg-gray-100 rounded w-3/4" />
                        </div>
                    </div>
                ))
            }
        </div>
    </div>

    <button
        id="load-more-btn"
        class="hidden mt-12 w-full py-5 border border-gray-200 rounded-2xl text-xs font-bold text-gray-600 hover:bg-gray-50 hover:border-gray-300 transition-all uppercase tracking-widest shadow-sm"
    >
        Browse Previous Comments
    </button>

    <!-- Delete Modal -->
    <div
        id="delete-modal"
        class="hidden fixed inset-0 z-[100] flex items-center justify-center p-4 bg-black/40 backdrop-blur-sm animate-in fade-in duration-300"
    >
        <div
            class="bg-white rounded-3xl p-8 max-w-sm w-full shadow-2xl animate-in zoom-in-95 duration-300"
        >
            <h3 class="text-xl font-bold text-gray-900 mb-2">
                Delete Comment?
            </h3>
            <p class="text-gray-600 text-sm mb-8 leading-relaxed">
                This action cannot be undone. Are you sure you want to remove
                your comment from this discussion?
            </p>
            <div class="flex gap-3">
                <button
                    id="cancel-delete"
                    class="flex-1 px-6 py-3 border border-gray-200 text-gray-600 font-bold rounded-2xl hover:bg-gray-50 transition-colors"
                    >Cancel</button
                >
                <button
                    id="confirm-delete"
                    class="flex-1 px-6 py-3 bg-red-600 text-white font-bold rounded-2xl hover:bg-red-700 transition-colors"
                    >Delete</button
                >
            </div>
        </div>
    </div>
</section>

<script>
    import * as api from "../../lib/api";

    async function initComments() {
        const section = document.getElementById("comments-section");
        const authPrompt = document.getElementById("auth-prompt");
        const formContainer = document.getElementById("comment-form-container");
        const loginBtn = document.getElementById("login-button");
        const input = document.getElementById(
            "comment-input",
        ) as HTMLTextAreaElement;
        const postBtn = document.getElementById(
            "post-comment-btn",
        ) as HTMLButtonElement;
        const limitText = document.getElementById("comment-limit-text");
        const avatar = document.getElementById(
            "user-avatar",
        ) as HTMLImageElement;
        const list = document.getElementById("comments-list");
        const loadMoreBtn = document.getElementById(
            "load-more-btn",
        ) as HTMLButtonElement;

        if (!section || !list) return;

        const postSlug = section.getAttribute("data-post-slug");
        let user: any = null;
        let page = 0;
        const pageSize = 10;
        let userCommentCount = 0;
        let unsubscribe: (() => void) | null = null;

        // Check Auth
        const {
            data: { session },
        } = await api.getSession();
        user = session?.user || null;

        if (user) {
            formContainer?.classList.remove("hidden");
            if (avatar) {
                avatar.src =
                    user.user_metadata?.avatar_url ||
                    `https://ui-avatars.com/api/?name=${encodeURIComponent(user.user_metadata?.full_name || "User")}`;
            }
            checkUserLimit();
        } else {
            authPrompt?.classList.remove("hidden");
        }

        // Login Handler
        loginBtn?.addEventListener("click", async () => {
            const redirectUrl =
                window.location.origin +
                window.location.pathname +
                "#interactions";
            await api.signInWithGoogle(redirectUrl);
        });

        // Input Handler
        input?.addEventListener("input", () => {
            postBtn.disabled =
                input.value.trim().length === 0 || userCommentCount >= 2;
        });

        // Post Comment
        postBtn?.addEventListener("click", async () => {
            if (!user || userCommentCount >= 2) return;

            const content = input.value.trim();
            if (!content) return;

            postBtn.disabled = true;
            const { data, error } = await api.addComment(
                postSlug,
                user.id,
                content,
            );

            if (!error) {
                input.value = "";
                prependComment({
                    ...data,
                    user_name: user.user_metadata?.full_name,
                    user_avatar: user.user_metadata?.avatar_url,
                });
                userCommentCount++;
                updateLimitUI();
            } else {
                console.error("Error posting comment:", error);
                alert("Failed to post comment. Please try again.");
            }
            postBtn.disabled = false;
        });

        // Fetch User Limit
        async function checkUserLimit() {
            if (!user) return;
            const { count, error } = await api.getUserCommentCount(
                postSlug,
                user.id,
            );

            if (!error && count !== null) {
                userCommentCount = count;
                updateLimitUI();
            }
        }

        function updateLimitUI() {
            if (!limitText) return;
            const left = Math.max(0, 2 - userCommentCount);
            limitText.textContent = `${left} comment${left === 1 ? "" : "s"} left`;

            if (left > 0) {
                input.disabled = false;
                input.placeholder = "Type your message...";
                // Re-validate post button state
                postBtn.disabled = input.value.trim().length === 0;
            } else {
                input.disabled = true;
                input.placeholder =
                    "You've reached the comment limit for this post.";
                postBtn.disabled = true;
            }
        }

        // Fetch and Render Comments
        async function fetchComments(p: number) {
            console.log("Fetching comments for:", postSlug, "page:", p);
            const { data, error } = await api.getComments(
                postSlug,
                p * pageSize,
                (p + 1) * pageSize - 1,
            );

            if (error) {
                console.error("Full Supabase Error:", error);

                if (p === 0) {
                    list!.innerHTML = `
                        <div class="p-6 bg-red-50 border border-red-100 rounded-2xl text-red-600 text-sm">
                            <p class="font-bold mb-1">Unable to load discussions</p>
                            <p class="opacity-80">${error.message}</p>
                        </div>
                    `;
                }
                return;
            }

            if (p === 0) {
                list!.innerHTML = "";
                updateCountHeader();
            }

            if (data && data.length > 0) {
                for (const comment of data) {
                    appendComment(comment);
                }
            }

            if (data && data.length < pageSize) {
                loadMoreBtn.classList.add("hidden");
            } else {
                loadMoreBtn.classList.remove("hidden");
            }
        }

        async function updateCountHeader() {
            const countHeader = document.getElementById("comment-count-header");
            if (countHeader) {
                const { count: realCount } =
                    await api.getCommentCount(postSlug);
                countHeader.textContent = `${realCount || 0} Comments`;
            }
        }

        function formatTime(date: string) {
            const now = new Date();
            const diff = now.getTime() - new Date(date).getTime();
            const seconds = Math.floor(diff / 1000);
            const minutes = Math.floor(seconds / 60);
            const hours = Math.floor(minutes / 60);
            const days = Math.floor(hours / 24);

            if (days > 0) return `${days}d ago`;
            if (hours > 0) return `${hours}h ago`;
            if (minutes > 0) return `${minutes}m ago`;
            return "Just now";
        }

        // Event Delegation for Edit/Delete
        list.addEventListener("click", async (e) => {
            const target = e.target as HTMLElement;
            const btn = target.closest("button");
            if (!btn) return;

            const id = btn.getAttribute("data-id");
            if (!id) return;

            if (btn.classList.contains("edit-btn")) {
                toggleEditMode(id, true);
            } else if (btn.classList.contains("cancel-edit")) {
                toggleEditMode(id, false);
            } else if (btn.classList.contains("save-edit")) {
                await handleSaveEdit(id);
            } else if (btn.classList.contains("delete-btn")) {
                await handleDeleteComment(id);
            }
        });

        function toggleEditMode(id: string, show: boolean) {
            const content = document.getElementById(`content-${id}`);
            const form = document.getElementById(`edit-form-${id}`);
            if (show) {
                content?.classList.add("hidden");
                form?.classList.remove("hidden");
                (
                    form?.querySelector("textarea") as HTMLTextAreaElement
                )?.focus();
            } else {
                content?.classList.remove("hidden");
                form?.classList.add("hidden");
            }
        }

        async function handleSaveEdit(id: string) {
            const form = document.getElementById(`edit-form-${id}`);
            const textarea = form?.querySelector(
                "textarea",
            ) as HTMLTextAreaElement;
            const content = textarea.value.trim();
            if (!content) return;

            const saveBtn = form?.querySelector(
                ".save-edit",
            ) as HTMLButtonElement;
            saveBtn.disabled = true;
            saveBtn.textContent = "...";

            const { error } = await api.updateComment(id, content);

            if (!error) {
                const contentDiv = document.getElementById(`content-${id}`);
                if (contentDiv) {
                    contentDiv.querySelector("p")!.textContent = content;
                }
                toggleEditMode(id, false);
            } else {
                alert("Failed to update comment.");
            }
            saveBtn.disabled = false;
            saveBtn.textContent = "Save Changes";
        }

        async function handleDeleteComment(id: string) {
            const modal = document.getElementById("delete-modal");
            const confirmBtn = document.getElementById("confirm-delete");
            const cancelBtn = document.getElementById("cancel-delete");

            if (!modal || !confirmBtn || !cancelBtn) return;

            modal.classList.remove("hidden");

            const handleCancel = () => {
                modal.classList.add("hidden");
                cleanup();
            };

            const handleConfirm = async () => {
                confirmBtn.textContent = "...";
                (confirmBtn as HTMLButtonElement).disabled = true;

                const { error } = await api.deleteComment(id);

                if (!error) {
                    document.getElementById(`comment-${id}`)?.remove();
                    updateCountHeader();
                    userCommentCount = Math.max(0, userCommentCount - 1);
                    updateLimitUI();
                    modal.classList.add("hidden");
                } else {
                    alert("Failed to delete comment.");
                }

                confirmBtn.textContent = "Delete";
                (confirmBtn as HTMLButtonElement).disabled = false;
                cleanup();
            };

            const cleanup = () => {
                confirmBtn.removeEventListener("click", handleConfirm);
                cancelBtn.removeEventListener("click", handleCancel);
                modal.removeEventListener("click", handleOverlayClick);
            };

            const handleOverlayClick = (e: MouseEvent) => {
                if (e.target === modal) handleCancel();
            };

            confirmBtn.addEventListener("click", handleConfirm);
            cancelBtn.addEventListener("click", handleCancel);
            modal.addEventListener("click", handleOverlayClick);
        }

        function createCommentHTML(comment: any) {
            const profile = comment.profiles || {};
            const name = profile.full_name || "Guest User";
            const avatarUrl =
                profile.avatar_url ||
                `https://ui-avatars.com/api/?name=${encodeURIComponent(name)}&background=random`;
            const isOwner = user && user.id === comment.user_id;
            const displayName = isOwner
                ? `<span class="text-indigo-600 bg-indigo-50 dark:bg-indigo-900/30 font-extrabold px-2 py-0.5 rounded-lg border border-indigo-100 dark:border-indigo-500/30 text-xs flex items-center gap-1.5"><span class="w-1.5 h-1.5 bg-indigo-500 rounded-full"></span>You</span>`
                : `<span class="text-gray-900">${name}</span>`;

            return `
        <div class="flex gap-4 sm:gap-6 group animate-in fade-in slide-in-from-bottom-2 duration-500 relative" id="comment-${comment.id}">
          <img src="${avatarUrl}" alt="${name}" class="w-12 h-12 rounded-2xl border border-gray-100 object-cover shadow-sm transition-transform group-hover:scale-105" />
          <div class="flex-1 min-w-0">
            <div class="flex items-center justify-between mb-1.5">
              <div class="flex items-center gap-3">
                <span class="text-sm font-bold flex items-center">${displayName}</span>
                <span class="text-[10px] text-gray-400 font-bold uppercase tracking-wider">${formatTime(comment.created_at)}</span>
              </div>
              ${
                  isOwner
                      ? `
                <div class="flex items-center gap-2 opacity-100 md:opacity-0 group-hover:opacity-100 transition-opacity">
                  <button class="edit-btn p-1.5 md:p-1 text-gray-400 hover:text-indigo-600 transition-colors" data-id="${comment.id}" aria-label="Edit comment">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
                  </button>
                  <button class="delete-btn p-1.5 md:p-1 text-gray-400 hover:text-red-500 transition-colors" data-id="${comment.id}" aria-label="Delete comment">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                  </button>
                </div>
              `
                      : ""
              }
            </div>
            
            <div id="content-${comment.id}" class="prose prose-sm max-w-none">
                <p class="text-gray-700 leading-relaxed text-sm whitespace-pre-wrap">${escapeHTML(comment.content)}</p>
            </div>

            <div id="edit-form-${comment.id}" class="hidden mt-3 space-y-3">
                <textarea class="edit-input w-full p-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none text-sm text-gray-800 resize-none min-h-[100px]">${escapeHTML(comment.content)}</textarea>
                <div class="flex justify-end gap-2">
                    <button class="cancel-edit px-4 py-1.5 text-xs font-bold text-gray-500 hover:text-gray-700 transition-colors" data-id="${comment.id}">Cancel</button>
                    <button class="save-edit px-4 py-1.5 bg-indigo-600 text-white text-xs font-bold rounded-lg hover:bg-indigo-700 transition-colors" data-id="${comment.id}">Save Changes</button>
                </div>
            </div>
          </div>
        </div>
      `;
        }

        function escapeHTML(str: string) {
            return str.replace(
                /[&<>'"]/g,
                (tag: string) =>
                    ({
                        "&": "&amp;",
                        "<": "&lt;",
                        ">": "&gt;",
                        "'": "&#39;",
                        '"': "&quot;",
                    })[tag] as string,
            );
        }

        function appendComment(comment: any) {
            const div = document.createElement("div");
            div.innerHTML = createCommentHTML(comment);
            list!.appendChild(div.firstElementChild!);
        }

        function prependComment(comment: any) {
            if (!comment.profiles && user) {
                comment.profiles = {
                    full_name: user.user_metadata?.full_name,
                    avatar_url: user.user_metadata?.avatar_url,
                };
            }
            const div = document.createElement("div");
            div.innerHTML = createCommentHTML(comment);
            list!.insertBefore(div.firstElementChild!, list!.firstChild);

            // Update header count locally
            const countHeader = document.getElementById("comment-count-header");
            if (countHeader) {
                const currentCount = parseInt(countHeader.textContent || "0");
                countHeader.textContent = `${currentCount + 1} Comments`;
            }
        }

        // Real-time subscription
        unsubscribe = api.subscribeToComments(postSlug, () => fetchComments(0));

        // Cleanup
        const cleanUp = () => unsubscribe && unsubscribe();
        window.addEventListener("beforeunload", cleanUp);
        document.addEventListener("astro:page-leave", cleanUp);

        // Load first page
        fetchComments(0);
        if (user) checkUserLimit();

        loadMoreBtn?.addEventListener("click", () => {
            page++;
            fetchComments(page);
        });
    }

    initComments();
    document.addEventListener("astro:page-load", initComments);
</script>
