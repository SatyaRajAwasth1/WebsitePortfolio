---
const { children } = Astro.props;
---

<div class="relative my-6">
  <div class="absolute left-0 top-0 bottom-0 w-1 rounded-full bg-indigo-500"></div>
  <div class="ml-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white/80 dark:bg-gray-900/40 backdrop-blur px-4 py-4">
    <div class="font-semibold mb-1 text-gray-900 dark:text-gray-100 tracking-wide">Note</div>
    <div class="text-[0.95rem] leading-relaxed text-gray-800 dark:text-gray-200">
      <slot />
    </div>
  </div>
</div>
