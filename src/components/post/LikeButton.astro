---
interface Props {
    postSlug: string;
}

const { postSlug } = Astro.props;
---

<div id="like-container" data-post-slug={postSlug} class="flex items-center">
    <button
        id="like-button"
        class="flex items-center gap-2 px-4 py-2 rounded-full border border-gray-200 dark:border-gray-700 hover:border-indigo-200 dark:hover:border-indigo-500 hover:bg-indigo-50/30 dark:hover:bg-indigo-900/20 transition-all duration-300 group"
        aria-label="Like this post"
    >
        <svg
            id="heart-icon"
            class="w-5 h-5 transition-transform group-hover:scale-110"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
        >
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
            ></path>
        </svg>
        <span
            id="like-count"
            class="text-sm font-bold text-gray-900 dark:text-indigo-300">0</span
        >
    </button>
</div>

<script>
    // @ts-nocheck
    import * as api from "../../lib/api";

    async function initLikes() {
        const container = document.getElementById("like-container");
        const button = document.getElementById("like-button");
        const countElement = document.getElementById("like-count");
        const heartIcon = document.getElementById("heart-icon");

        if (!container || !button || !countElement || !heartIcon) return;

        const postSlug = container.getAttribute("data-post-slug");
        let user = null;
        let isLiked = false;
        let count = 0;
        let unsubscribe;

        // Fetch session
        const {
            data: { session },
        } = await api.getSession();
        user = session?.user || null;

        async function fetchCount() {
            const { count: total } = await api.getLikeCount(postSlug);
            if (total !== null) {
                count = total;
                countElement.textContent = count.toString();
            }
        }

        async function checkUserLike() {
            if (!user) return;
            const { data } = await api.getUserLike(postSlug, user.id);
            if (data) {
                isLiked = true;
                updateUI();
            }
        }

        function updateUI() {
            if (isLiked) {
                heartIcon.setAttribute("fill", "currentColor");
                heartIcon.classList.add("text-indigo-500");
                heartIcon.classList.remove("text-gray-400");
                button.classList.add(
                    "border-indigo-200",
                    "bg-indigo-50/50",
                    "dark:border-indigo-500/50",
                    "dark:bg-indigo-500/10",
                );
            } else {
                heartIcon.setAttribute("fill", "none");
                heartIcon.classList.remove("text-indigo-500");
                heartIcon.classList.add("text-gray-400");
                button.classList.remove(
                    "border-indigo-200",
                    "bg-indigo-50/50",
                    "dark:border-indigo-500/50",
                    "dark:bg-indigo-500/10",
                );
            }
            countElement.textContent = count.toString();
        }

        await fetchCount();
        if (user) await checkUserLike();
        updateUI();

        button.addEventListener("click", async () => {
            if (!user) {
                const redirectUrl =
                    window.location.origin +
                    window.location.pathname +
                    "#interactions";
                await api.signInWithGoogle(redirectUrl);
                return;
            }

            button.disabled = true;

            if (isLiked) {
                await api.unlikePost(postSlug, user.id);
                isLiked = false;
                count--;
            } else {
                await api.likePost(postSlug, user.id);
                isLiked = true;
                count++;
            }

            updateUI();
            button.disabled = false;
        });

        // Subscribe to updates
        unsubscribe = api.subscribeToLikes(postSlug, fetchCount);

        // Cleanup on page leave
        const cleanUp = () => unsubscribe && unsubscribe();
        window.addEventListener("beforeunload", cleanUp);
        document.addEventListener("astro:page-leave", cleanUp);
    }

    initLikes();
    document.addEventListener("astro:page-load", initLikes);
</script>
