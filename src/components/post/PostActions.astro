---
import LikeButton from "./LikeButton.astro";
import ShareButton from "./ShareButton.astro";

interface Props {
    postSlug: string;
    postTitle: string;
}

const { postSlug, postTitle } = Astro.props;
const currentUrl = typeof window !== "undefined" ? window.location.href : "";
---

<div class="my-16 flex items-center justify-between gap-4">
    <div class="flex items-center gap-3">
        <LikeButton postSlug={postSlug} />

        <button
            id="scroll-to-comments"
            class="flex items-center gap-2 px-4 py-2 rounded-full border border-gray-200 dark:border-gray-700 hover:border-indigo-200 dark:hover:border-indigo-500 hover:bg-indigo-50/30 dark:hover:bg-indigo-900/20 transition-all duration-300 group"
            aria-label="View comments"
        >
            <svg
                class="w-5 h-5 text-gray-400 group-hover:text-indigo-600 transition-colors"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                xmlns="http://www.w3.org/2000/svg"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
                ></path>
            </svg>
            <span
                id="comment-count-badge"
                class="text-sm font-bold text-gray-900 dark:text-indigo-300"
                >0</span
            >
        </button>
    </div>

    <div class="flex items-center gap-4">
        <ShareButton title={postTitle} url={currentUrl} />

        <div
            id="account-status-container"
            class="hidden h-10 w-px bg-gray-300 dark:bg-gray-800"
        >
        </div>

        <div id="post-account-box" class="hidden relative group/avatar">
            <button
                id="post-account-trigger"
                class="flex items-center gap-2 px-2.5 py-1.5 rounded-xl border border-gray-200 dark:border-gray-700 hover:border-indigo-200 dark:hover:border-indigo-500 hover:bg-indigo-50/30 dark:hover:bg-indigo-900/20 transition-all duration-300"
            >
                <img
                    id="post-user-avatar"
                    src=""
                    alt="Account"
                    class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg object-cover ring-2 ring-gray-100 group-hover:ring-indigo-300 transition-all duration-200"
                />
                <svg
                    class="w-5 h-5 text-gray-400 group-hover:text-indigo-600 transition-colors"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19 9l-7 7-7-7"></path></svg
                >
            </button>
            <div
                id="post-account-dropdown"
                class="hidden absolute right-0 top-full mt-2 w-64 sm:w-72
           bg-white
           backdrop-blur-xl rounded-2xl shadow-2xl
           border border-gray-200 dark:border-indigo-700/40
           overflow-hidden z-[100]
           animate-in fade-in zoom-in-95 duration-200 origin-top-right"
            >
                <!-- INDIGO PROFILE HEADER -->
                <div class="px-4 py-4 bg-gray-50/80 text-black">
                    <div class="flex items-center gap-3">
                        <img
                            id="post-dropdown-avatar"
                            src=""
                            alt="Profile"
                            class="w-12 h-12 rounded-xl object-cover ring-2 ring-white/40"
                        />
                        <div class="flex-1 min-w-0">
                            <p
                                id="post-dropdown-name"
                                class="text-sm font-bold truncate"
                            >
                            </p>
                            <p
                                id="post-dropdown-email"
                                class="text-xs text-black/80 truncate mt-0.5"
                            >
                            </p>
                        </div>
                    </div>
                </div>

                <!-- ACTION AREA -->
                <div class="p-2 bg-white/70 dark:bg-transparent">
                    <button
                        id="post-logout-btn"
                        class="flex items-center gap-3 w-full px-4 py-2.5 text-sm font-semibold
                   text-red-600 dark:text-red-400
                   hover:bg-red-50 dark:hover:bg-red-900/20
                   rounded-xl transition-all text-left group"
                    >
                        <svg
                            class="w-5 h-5 transition-transform group-hover:translate-x-0.5"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"
                            ></path>
                        </svg>
                        <span>Sign Out</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // @ts-nocheck
    import * as api from "../../lib/api";

    async function initPostActions() {
        const scrollBtn = document.getElementById("scroll-to-comments");
        const commentBadge = document.getElementById("comment-count-badge");
        const likeContainer = document.getElementById("like-container");
        const postSlug = likeContainer?.getAttribute("data-post-slug");

        // Auth UI Elements
        const accountBox = document.getElementById("post-account-box");
        const accountDivider = document.getElementById(
            "account-status-container",
        );
        const avatar = document.getElementById("post-user-avatar");
        const trigger = document.getElementById("post-account-trigger");
        const dropdown = document.getElementById("post-account-dropdown");
        const logoutBtn = document.getElementById("post-logout-btn");
        const dropdownName = document.getElementById("post-dropdown-name");
        const dropdownEmail = document.getElementById("post-dropdown-email");
        const dropdownAvatar = document.getElementById("post-dropdown-avatar");

        // Scroll to comments
        scrollBtn?.addEventListener("click", () => {
            document
                .getElementById("interactions")
                ?.scrollIntoView({ behavior: "smooth" });
        });

        // Auth Logic
        const {
            data: { session },
        } = await api.getSession();
        const user = session?.user;

        if (user && accountBox && avatar) {
            accountBox.classList.remove("hidden");
            accountDivider?.classList.remove("hidden");

            const name = user.user_metadata?.full_name || "Account";
            const realAvatar = user.user_metadata?.avatar_url;
            avatar.src =
                realAvatar ||
                `https://ui-avatars.com/api/?name=${encodeURIComponent(name)}&background=6366f1&color=ffffff&bold=true&size=128&rounded=false&font-size=0.4`;

            if (dropdownAvatar) dropdownAvatar.src = realAvatar || avatar.src;
            if (dropdownName) dropdownName.textContent = name;
            if (dropdownEmail) dropdownEmail.textContent = user.email || "";

            trigger?.addEventListener("click", (e) => {
                e.stopPropagation();
                dropdown?.classList.toggle("hidden");
            });

            document.addEventListener("click", () =>
                dropdown?.classList.add("hidden"),
            );

            logoutBtn?.addEventListener("click", async () => {
                const { error } = await api.signOut();
                if (!error) window.location.reload();
            });
        }

        // Comment Count Logic
        let unsubscribe;

        if (commentBadge && postSlug) {
            async function fetchCommentCount() {
                const { count } = await api.getCommentCount(postSlug);
                commentBadge.textContent = (count || 0).toString();
            }

            fetchCommentCount();
            unsubscribe = api.subscribeToComments(postSlug, fetchCommentCount);
        }

        // Cleanup on page leave
        const cleanUp = () => unsubscribe && unsubscribe();
        window.addEventListener("beforeunload", cleanUp);
        document.addEventListener("astro:page-leave", cleanUp);
    }

    initPostActions();
    document.addEventListener("astro:page-load", initPostActions);
</script>
