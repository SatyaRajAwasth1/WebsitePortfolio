---
// SeriesNav.astro
const { prev, next } = Astro.props;
---

<nav class="flex flex-col sm:flex-row justify-between items-center gap-4 my-12 text-indigo-600 font-medium">
  {prev ? (
    <a href={`/blogs/${prev.slug}`} class="hover:underline text-left w-full sm:w-auto">
      ← {prev.data.title}
    </a>
  ) : <span />}

  {next ? (
    <a href={`/blogs/${next.slug}`} class="hover:underline text-right w-full sm:w-auto">
      {next.data.title} →
    </a>
  ) : <span />}
</nav>
