---
// SeriesNav.astro
const { prev, next } = Astro.props;
---

<nav class="grid grid-cols-1 sm:grid-cols-2 gap-6 my-16">
  {
    prev ? (
      <a
        href={`/blogs/${prev.slug}`}
        class="group p-6 rounded-2xl border border-gray-100 hover:border-indigo-200 hover:bg-indigo-50/30 transition-all duration-300 flex flex-col gap-2"
      >
        <span class="text-xs font-bold text-indigo-400 uppercase tracking-widest flex items-center gap-2">
          <svg
            class="w-4 h-4 transition-transform group-hover:-translate-x-1"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15 19l-7-7 7-7"
            />
          </svg>
          Previous Part
        </span>
        <span class="text-gray-900 font-bold group-hover:text-indigo-600 transition-colors">
          {prev.data.title}
        </span>
      </a>
    ) : (
      <div />
    )
  }

  {
    next ? (
      <a
        href={`/blogs/${next.slug}`}
        class="group p-6 rounded-2xl border border-gray-100 hover:border-indigo-200 hover:bg-indigo-50/30 transition-all duration-300 flex flex-col gap-2 text-right"
      >
        <span class="text-xs font-bold text-indigo-400 uppercase tracking-widest flex items-center gap-2 justify-end">
          Next Part
          <svg
            class="w-4 h-4 transition-transform group-hover:translate-x-1"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 5l7 7-7 7"
            />
          </svg>
        </span>
        <span class="text-gray-900 font-bold group-hover:text-indigo-600 transition-colors">
          {next.data.title}
        </span>
      </a>
    ) : (
      <div />
    )
  }
</nav>
