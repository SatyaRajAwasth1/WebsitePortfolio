---
interface Props {
    title: string;
    url: string;
}

const { title, url } = Astro.props;
---

<div
    class="relative inline-block text-left"
    id="share-container"
    data-title={title}
    data-url={url}
>
    <button
        id="share-button"
        class="flex items-center gap-2 px-4 py-2 rounded-full border border-gray-200 dark:border-gray-700 hover:border-indigo-200 dark:hover:border-indigo-500 hover:bg-indigo-50/30 dark:hover:bg-indigo-900/20 transition-all duration-300 group"
        aria-label="Share this post"
    >
        <svg
            class="w-5 h-5 text-gray-400 group-hover:text-indigo-600 transition-colors"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
        >
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"
            ></path>
        </svg>
        <span class="text-sm font-bold text-gray-700 dark:text-indigo-300"
            >Share</span
        >
    </button>

    <!-- Share Dropdown (Fallback) -->
    <div
        id="share-dropdown"
        class="hidden absolute right-0 bottom-full mb-3 w-56 rounded-2xl bg-white dark:bg-gray-900 shadow-2xl border border-gray-100 dark:border-gray-800 py-2 z-50 origin-bottom-right transition-all duration-300"
    >
        <div
            class="px-4 py-2 border-b border-gray-50 dark:border-gray-800 mb-1"
        >
            <span
                class="text-[10px] font-bold text-indigo-400 uppercase tracking-widest"
                >Share this article</span
            >
        </div>
        <button
            class="share-option flex items-center gap-3 w-full px-4 py-2.5 text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-indigo-50 dark:hover:bg-indigo-900/30 hover:text-indigo-600 transition-colors text-left"
            data-type="copy"
        >
            <svg
                class="w-4 h-4 opacity-70"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"
                ></path></svg
            >
            Copy Link
        </button>
        <a
            href="#"
            target="_blank"
            class="share-option flex items-center gap-3 px-4 py-2.5 text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-indigo-50 dark:hover:bg-indigo-900/30 hover:text-indigo-600 transition-colors"
            data-type="twitter"
        >
            <svg
                class="w-4 h-4 opacity-70"
                fill="currentColor"
                viewBox="0 0 24 24"
                ><path
                    d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.84 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"
                ></path></svg
            >
            X / Twitter
        </a>
        <a
            href="#"
            target="_blank"
            class="share-option flex items-center gap-3 px-4 py-2.5 text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-indigo-50 dark:hover:bg-indigo-900/30 hover:text-indigo-600 transition-colors"
            data-type="linkedin"
        >
            <svg
                class="w-4 h-4 opacity-70"
                fill="currentColor"
                viewBox="0 0 24 24"
                ><path
                    d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451c.981 0 1.775-.773 1.775-1.729V1.729C24 .774 23.206 0 22.225 0z"
                ></path></svg
            >
            LinkedIn
        </a>
    </div>
</div>

<script>
    function initShare() {
        const container = document.getElementById("share-container");
        const button = document.getElementById("share-button");
        const dropdown = document.getElementById("share-dropdown");

        if (!container || !button || !dropdown) return;

        const title = container.getAttribute("data-title") || "";
        const url = container.getAttribute("data-url") || window.location.href;

        button.addEventListener("click", async (e) => {
            e.stopPropagation();
            if (navigator.share) {
                try {
                    await navigator.share({ title, url });
                } catch (err) {
                    console.error("Error sharing:", err);
                }
            } else {
                dropdown.classList.toggle("hidden");
            }
        });

        // Close dropdown on outside click
        document.addEventListener("click", () => {
            dropdown.classList.add("hidden");
        });

        // Handle options
        const options = container.querySelectorAll(".share-option");
        options.forEach((opt) => {
            const type = opt.getAttribute("data-type");
            const shareUrl = encodeURIComponent(url);
            const shareTitle = encodeURIComponent(title);

            if (type === "twitter") {
                (opt as HTMLAnchorElement).href =
                    `https://twitter.com/intent/tweet?text=${shareTitle}&url=${shareUrl}`;
            } else if (type === "linkedin") {
                (opt as HTMLAnchorElement).href =
                    `https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`;
            } else if (type === "copy") {
                opt.addEventListener("click", () => {
                    navigator.clipboard.writeText(url);
                    const originalText = opt.textContent;
                    opt.textContent = "Copied!";
                    setTimeout(() => {
                        opt.innerHTML = `<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path></svg> Copy Link`;
                    }, 2000);
                });
            }
        });
    }

    initShare();
    document.addEventListener("astro:page-load", initShare);
</script>
