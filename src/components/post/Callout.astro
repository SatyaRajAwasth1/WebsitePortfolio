---
type CalloutType = "info" | "warning" | "error" | "success";
const { type = "info", title } = Astro.props as { type?: CalloutType; title?: string };

const colors = {
  info: "bg-blue-50 border-blue-400 text-blue-900",
  warning: "bg-yellow-50 border-yellow-400 text-yellow-900",
  error: "bg-red-50 border-red-400 text-red-900",
  success: "bg-green-50 border-green-400 text-green-900",
};
const colorClass = colors[type as CalloutType] || colors.info;
---

<aside
  class={`border-l-4 p-4 rounded-xl shadow-sm mb-6 ${colorClass} font-sans`}
  role="region"
  aria-label={title || type}
>
  {title && <h4 class="font-semibold mb-2">{title}</h4>}
  <div class="text-sm leading-relaxed">
    <slot />
  </div>
</aside>
