---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  BLOG_CATEGORIES,
  BLOG_CATEGORY_NAMES,
  type BlogCategory,
} from "../../constants/categories";

// Fetch and sort all blog posts by date
const allPosts = (await getCollection("blog")).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

// Initialize a map of posts by category name
const postsByCategory: Record<BlogCategory, typeof allPosts> = Object.fromEntries(
  BLOG_CATEGORY_NAMES.map((name) => [name, []])
) as Record<BlogCategory, typeof allPosts>;

// Group posts into the map
for (const post of allPosts) {
  const cat = post.data.category as BlogCategory;
  if (postsByCategory[cat]) {
    postsByCategory[cat].push(post);
  }
}

// Format date to readable string
function formatDate(dateStr: string): string {
  return new Date(dateStr).toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
}
---

<BaseLayout title="All Blogs">
  <section class="max-w-4xl mx-auto px-4 md:px-0 py-10">
    <h1 class="text-4xl font-bold text-gray-900 mb-6">All Blog Posts</h1>

    <p class="text-gray-600 text-base leading-relaxed mb-10">
      Learning is an everyday process — whether it’s theory from a professor in
      a university classroom or scrolling web pages, technical documentations
      and StackOverflow question-answers during debugging. That’s true for me
      too. I often learn something today and forget it tomorrow — which is why I
      like to share what I’ve learned. These are some of my personal engineering
      experiences, deep dives, and quick overviews where I’ve tried to explain
      things in a simpler or more helpful way than what’s already out there — or
      in case no one has written about it yet.
    </p>

    <div class="space-y-12">
      {
        BLOG_CATEGORIES.map(({ name, description }) => {
          const posts = postsByCategory[name as BlogCategory];
          if (!posts.length) return null;

          return (
            <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6">
              <h2 class="text-2xl font-semibold text-gray-800 mb-1">{name}</h2>
              <p class="text-gray-500 text-sm mb-4">{description}</p>

              <ul class="list-disc marker:text-indigo-500 pl-6 space-y-3">
                {posts.slice(0, 3).map((post) => (
                  <li class="hover:translate-x-1 transition-transform duration-150">
                    <span class="text-sm text-gray-500 mr-2">
                      {formatDate(post.data.date)}
                    </span>
                    <a
                      href={`/blogs/${post.slug}`}
                      class="text-indigo-700 hover:text-indigo-900 hover:underline text-base font-medium"
                    >
                      {post.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          );
        })
      }
    </div>
  </section>
</BaseLayout>
