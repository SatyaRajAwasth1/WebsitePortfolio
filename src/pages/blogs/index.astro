---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import {
  BLOG_CATEGORIES,
  BLOG_CATEGORY_NAMES,
  type BlogCategory,
} from "../../constants/categories";

// Fetch and sort all blog posts by date
const allPosts = (await getCollection("blog")).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);

// Initialize a map of posts by category name
const postsByCategory: Record<BlogCategory, typeof allPosts> =
  Object.fromEntries(
    BLOG_CATEGORY_NAMES.map((name) => [name, []]),
  ) as unknown as Record<BlogCategory, typeof allPosts>;

// Group posts into the map
for (const post of allPosts) {
  const cat = post.data.category as BlogCategory;
  if (postsByCategory[cat]) {
    postsByCategory[cat].push(post);
  }
}

// Format date to readable string
function formatDate(dateStr: string): string {
  return new Date(dateStr).toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
}
---

<BaseLayout title="All Blogs">
  <section class="max-w-4xl mx-auto px-4 md:px-0 py-10 md:py-16">
    <Breadcrumbs items={[{ label: "Blogs" }]} />

    <header class="mb-16">
      <h1
        class="text-4xl md:text-5xl font-bold text-gray-900 mb-6 tracking-tight"
      >
        Engineering Diaries
      </h1>
      <p class="text-gray-600 text-lg leading-relaxed max-w-2xl font-medium">
        Sharing my journey through programming, architecture, and systems
        engineering. Raw thoughts, deep dives, and everyday learnings.
      </p>
    </header>

    <div class="space-y-20">
      {
        BLOG_CATEGORIES.map(({ name, description }) => {
          const posts = postsByCategory[name as BlogCategory];
          if (!posts.length) return null;

          return (
            <div id={name} class="scroll-mt-24">
              <div class="flex items-center gap-4 mb-8">
                <h2 class="text-xl font-bold text-gray-400 uppercase tracking-[0.2em] whitespace-nowrap">
                  {name}
                </h2>
                <div class="h-[1px] w-full bg-gray-100" />
              </div>

              <ul class="space-y-12 pl-0 md:pl-8">
                {posts.map((post) => (
                  <li class="group">
                    <div class="flex flex-col gap-2">
                      <time class="text-xs font-bold text-gray-400 uppercase tracking-widest">
                        {formatDate(post.data.date)}
                      </time>
                      <a
                        href={`/blogs/${post.slug}`}
                        class="text-2xl font-bold text-gray-800 group-hover:text-indigo-600 transition-colors duration-200 leading-tight"
                      >
                        {post.data.title}
                      </a>
                      <p class="text-gray-500 text-base leading-relaxed line-clamp-2 mt-1">
                        {post.data.description}
                      </p>
                      <div class="mt-4 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                        <span class="text-indigo-600 font-bold text-sm flex items-center gap-1">
                          Read Full Article
                          <svg
                            class="w-4 h-4"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M17 8l4 4m0 0l-4 4m4-4H3"
                            />
                          </svg>
                        </span>
                      </div>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          );
        })
      }
    </div>
  </section>
</BaseLayout>
