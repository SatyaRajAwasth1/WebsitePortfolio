---
import { components } from '../components/post/post-mdx-components';
import SeriesNav from '../components/post/SeriesNav.astro';
import TableOfContents from '../components/post/TableOfContents.astro';

type BlogEntry = { slug: string; data: { title: string; series?: { part: number } } };
const { post, series = [], toc = [] } = Astro.props as {
  post: { slug: string; data: { title: string; date: string; coverImage?: string; showTOC?: boolean; series?: { title: string; part: number } }; Content: any };
  series: BlogEntry[];
  toc: Array<{ id: string; text: string; level: number }>;
};
const showTOC = Boolean(post?.data?.showTOC) && Array.isArray(toc) && toc.length > 0;
---

<article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

  <!-- Hero Section: Title & Meta -->
  <section class="mb-12">
    <div class="text-center">
      <h1 class="text-3xl sm:text-4xl font-extrabold leading-tight text-gray-900">
        {post.data.title}
      </h1>
      <p class="text-sm mt-2 text-gray-500 dark:text-gray-400">
        {new Date(post.data.date).toLocaleDateString('en-US', { dateStyle: 'long' })}
      </p>
    </div>
  </section>

  <!-- Series Info (Top) -->
  {series.length > 0 && (
    <aside class="bg-white/70 dark:bg-gray-900/50 backdrop-blur-md border border-gray-200 dark:border-gray-700 p-4 my-8 rounded-2xl">
      <h3 class="font-semibold mb-2 text-gray-900 dark:text-gray-100">Series: {post.data.series?.title}</h3>
      <ul class="ml-1 mt-1 text-sm text-gray-800 dark:text-gray-200 space-y-1">
        {series.map((part: BlogEntry) => {
          const isCurrent = part.slug === post.slug;
          return (
            <li class={`rounded-md`}>
              <a
                href={`/blogs/${part.slug}`}
                aria-current={isCurrent ? 'page' : undefined}
                class={`block px-3 py-1.5 rounded-md transition-colors hover:bg-gray-100/70 dark:hover:bg-gray-800/60 ${isCurrent ? 'font-semibold text-gray-900 dark:text-gray-100 bg-gray-100/80 dark:bg-gray-800/60' : ''}`}
              >
                Part {part.data.series?.part}: {part.data.title}
              </a>
            </li>
          );
        })}
      </ul>
    </aside>
  )}

  <!-- Mobile TOC (top) -->
  {showTOC && (
    <div class="md:hidden mb-8">
      <TableOfContents items={toc} />
    </div>
  )}

  <!-- Main Content with optional desktop TOC -->
  <div class={`grid gap-10 ${showTOC ? 'md:grid-cols-[minmax(0,1fr)_300px]' : ''}`}>
    <div class="prose lg:prose-lg max-w-none">
      <post.Content components={components} />
    </div>

    {showTOC && (
      <aside class="hidden md:block">
        <TableOfContents items={toc} />
      </aside>
    )}
  </div>

  <!-- Series Navigation (Bottom) -->
  {post.data.series && (
    <div class="mt-16 border-t border-gray-200 dark:border-gray-700 pt-8">
      {(() => {
        const currentPart = post.data.series?.part;
        if (typeof currentPart !== 'number') return null;
        return (
          <SeriesNav
            prev={series.find((p: BlogEntry) => (p.data.series?.part ?? -Infinity) === currentPart - 1)}
            next={series.find((p: BlogEntry) => (p.data.series?.part ?? -Infinity) === currentPart + 1)}
          />
        );
      })()}
    </div>
  )}

</article>
